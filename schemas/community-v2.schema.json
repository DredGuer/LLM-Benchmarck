      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputSchemaDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "read-file",
              "write-file",
              "create-directory",
              "move-file",
              "network",
              "shell",
              "other"
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "capabilities"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "mediaType": {
          "type": [
            "string",
            "null"
          ]
        },
        "sizeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "relativePath",
        "kind"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "answer",
            "tool-call",
            "create-directory",
            "write-file",
            "move-file",
            "verify",
            "other"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "toolId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "success",
            "failure",
            "skipped",
            "timeout",
            "cancelled",
            "unknown"
          ]
        },
        "duration": {
          "$ref": "#/$defs/measurement"
        },
        "toolCallCount": {
          "type": "integer",
          "minimum": 0
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "evaluator": {
                "type": "string",
                "minLength": 1
              },
              "evaluatorVersion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "passed",
              "evaluator",
              "evaluatorVersion"
            ]
          }
        }
      },
      "required": [
        "id",
        "order",
        "action",
        "dependsOn",
        "status",
        "toolCallCount",
        "retryCount",
        "artifactIds",
        "checks"
      ]
    },
    "agentic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orchestrator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "agentCount": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "name",
            "version",
            "agentCount"
          ]
        },
        "workspacePolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "isolated-test-directory"
            },
            "networkAllowed": {
              "type": "boolean"
            },
            "shellAllowed": {
              "type": "boolean"
            },
            "outsideWorkspaceAllowed": {
              "const": false
            }
          },
          "required": [
            "scope",
            "networkAllowed",
            "shellAllowed",
            "outsideWorkspaceAllowed"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSteps": {
              "type": "integer",
              "minimum": 1
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 0
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "maxSteps",
            "maxToolCalls",
            "timeoutMs"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "taskSuccess": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "evaluator": {
              "type": "string",
              "minLength": 1
            },
            "evaluatorVersion": {
              "type": "string",
              "minLength": 1
            },
            "successRate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "toolCallCount": {
              "type": "integer",
              "minimum": 0
            },
            "retryCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "taskSuccess",
            "evaluator",
            "evaluatorVersion",
            "toolCallCount",
            "retryCount"
          ]
        }
      },
      "required": [
        "orchestrator",
        "workspacePolicy",
        "tools",
        "budget",
        "steps",
        "artifacts",
        "evaluation"
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "generation",
            "agentic"
          ]
        },
        "status": {
          "enum": [
            "success",
            "failure",
            "timeout",
            "cancelled",
            "partial"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "participatingNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "resourceSamples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceSample"
          }
        },
        "resourceSummaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceSummary"
          }
        },
        "agentic": {
          "$ref": "#/$defs/agentic"
        },
        "failureCode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "startedAt",
        "model",
        "parameters",
        "protocol",
        "participatingNodeIds",
        "metrics",
        "resourceSamples",
        "resourceSummaries"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "agentic"
            }
          },
          "required": [
            "agentic"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "generation"
            }
          },
          "not": {
            "required": [
              "agentic"
            ]
          }
        }
      ]
    }
  }
}
