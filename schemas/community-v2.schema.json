            "unknown"
          ]
        },
        "capacity": {
          "$ref": "#/$defs/measurement"
        },
        "sharedMemoryPoolId": {
          "type": [
            "string",
            "null"
          ]
        },
        "driverVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "computeBackend": {
          "type": [
            "string",
            "null"
          ]
        },
        "computeUnits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "id",
        "model",
        "kind",
        "memoryArchitecture",
        "capacity"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "ssd",
            "hdd",
            "network",
            "other",
            "unknown"
          ]
        },
        "transport": {
          "enum": [
            "nvme",
            "sata",
            "usb",
            "thunderbolt",
            "network",
            "other",
            "unknown"
          ]
