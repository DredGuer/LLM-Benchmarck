{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DredGuer/LLM-Benchmarck/main/schemas/community-v2.schema.json",
  "title": "LLM Benchmarker community report v2 (contract; collectors staged)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "llm-benchmarker.community"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "community-redacted"
        },
        "rawPromptsIncluded": {
          "const": false
        },
        "rawResponsesIncluded": {
          "const": false
        },
        "rawToolArgumentsIncluded": {
          "const": false
        }
      },
      "required": [
        "profile",
        "rawPromptsIncluded",
        "rawResponsesIncluded",
        "rawToolArgumentsIncluded"
      ]
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/machine"
      },
      "minItems": 1
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "reportId",
    "generatedAt",
    "producer",
    "synthetic",
    "privacy",
    "machines",
    "execution",
    "tests"
  ],
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "bytes",
            "ms",
            "tokens",
            "tokens/s",
            "percent",
            "watts",
            "celsius",
            "hertz",
            "bytes/s",
            "count",
            "joules"
          ]
        },
        "status": {
          "enum": [
            "available",
            "unsupported",
            "unavailable",
            "permission-denied",
            "error"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "measured",
            "declared",
            "estimated"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "enum": [
            "machine",
            "cpu",
            "gpu",
            "process-tree",
            "model",
            "storage",
            "link",
            "test"
          ]
        },
        "nodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "unit",
        "status",
        "source",
        "kind",
        "observedAt",
        "scope"
      ],
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "status": {
              "enum": [
                "unsupported",
                "unavailable",
                "permission-denied",
                "error"
              ]
            },
            "value": {
              "type": "null"
            }
          }
        }
      ]
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "socketCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "physicalCores": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "logicalCores": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "performanceCores": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "efficiencyCores": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "numaNodes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "instructionSets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frequency": {
          "$ref": "#/$defs/measurement"
        }
      },
      "required": [
        "id",
        "model"
      ]
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "enum": [
            "unified",
            "separate",
            "unknown"
          ]
        },
        "physicalCapacity": {
          "$ref": "#/$defs/measurement"
        },
        "availableBeforeTest": {
          "$ref": "#/$defs/measurement"
        },
        "bandwidth": {
          "$ref": "#/$defs/measurement"
        },
        "swapCapacity": {
          "$ref": "#/$defs/measurement"
        }
      },
      "required": [
        "architecture",
        "physicalCapacity"
      ]
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
