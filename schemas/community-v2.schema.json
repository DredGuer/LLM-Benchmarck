          }
        }
      },
      "required": [
        "id",
        "kind",
        "transport",
        "roles"
      ]
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "object",
