{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Benchmarker community report bundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "llm-benchmarker.community.bundle"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "community-normalized.schema.json"
      }
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "reports"
  ],
  "$id": "https://raw.githubusercontent.com/DredGuer/LLM-Benchmarker/main/schemas/community-normalized-bundle.schema.json"
}
